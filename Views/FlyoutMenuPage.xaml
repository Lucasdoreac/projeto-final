<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:appClassePessoaBD.Views"
             x:Class="appClassePessoaBD.Views.FlyoutMenuPage"
             Title="Menu">

    <ContentPage.Content>
        <Grid RowDefinitions="Auto, *" Padding="0">
            <!-- Cabeçalho do Menu -->
            <Frame Grid.Row="0"
                   BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#1976D2}"
                   CornerRadius="0"
                   Padding="20"
                   Margin="0">
                <StackLayout>
                    <Label Text="Cadastro de Pessoas"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="White" />
                    <Label Text="Programação Para Dispositivos Móveis 2026"
                           FontSize="11"
                           TextColor="#E3F2FD" />
                </StackLayout>
            </Frame>

            <!-- Itens do Menu -->
            <ListView Grid.Row="1"
                      x:Name="menuListView"
                      SeparatorVisibility="None"
                      BackgroundColor="Transparent"
                      RowHeight="60">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D2D}"
                                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                                   CornerRadius="8"
                                   Padding="15"
                                   Margin="10,5">
                                <StackLayout Orientation="Horizontal" Spacing="15">
                                    <Label Text="{Binding Icon}"
                                           FontSize="22"
                                           VerticalOptions="Center"
                                           Width="30" />
                                    <Label Text="{Binding Title}"
                                           FontSize="15"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#212121, Dark=#FFFFFF}" />
                                </StackLayout>
                            </Frame>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </ContentPage.Content>

</ContentPage>
