<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appClassePessoaBD.Views.TelaSobre"
             BackgroundImageSource="fundo.png"
             Title="Sobre">

    <ContentPage.Content>
        <ScrollView>
            <Grid RowDefinitions="Auto, *">
                <!-- Info básica do app -->
                <StackLayout Grid.Row="0" Padding="20" Spacing="10">
                    <Label Text="Cadastro de Pessoas - Versão 1.0"
                           FontSize="Title"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />

                    <Label Text="Programação Para Dispositivos Móveis 2026"
                           FontAttributes="Bold"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Documentação e código-fonte no GitHub (WebView embedded):"
                           FontSize="12"
                           HorizontalTextAlignment="Center"
                           Margin="0,5,0,0" />
                </StackLayout>

                <!-- WebView EMBEDDED - GitHub dentro do app -->
                <WebView x:Name="githubWebView"
                         Grid.Row="1"
                         HeightRequest="400"
                         Source="https://github.com/lucasdoreac/projeto-final" />
            </Grid>
        </ScrollView>
    </ContentPage.Content>

</ContentPage>
